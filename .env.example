# TrackUp Environment Configuration Template
# DO NOT commit real secrets or service role keys to version control.

# Supabase (Local or Hosted)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application Configuration
VITE_APP_NAME="TrackUp"
VITE_APP_TAGLINE="Track what you love."

# TMDB Metadata API (Optional: unlocks live Movie & TV catalog; Anime & Manga use free public AniList)
VITE_TMDB_API_KEY=
VITE_TMDB_READ_ACCESS_TOKEN=
